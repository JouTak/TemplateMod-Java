{
  "schemaVersion": 1,
  "id": "${MOD_ID}",
  "version": "${VERSION}",
  "name": "${MOD_NAME}",
  "icon": "assets/templatemod/textures/icon.png",
  "description": "Records your route, marks it with arrows, and helps you find your way back.",
  "authors": [
    "WeNeedFood"
  ],
  "contact": {
    "homepage": "https://joutak.ru",
    "sources": "${WEBSITE}"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "ru.joutak.templatemod.TemplateMod"
    ],
    "client": [
      "ru.joutak.templatemod.client.TemplateModClient"
    ],
    "modmenu": [
      "ru.joutak.templatemod.compat.ModMenuIntegration"
    ],
    "lambdynlights:initializer": [
      "ru.joutak.templatemod.compat.DynamicLightsIntegration"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
